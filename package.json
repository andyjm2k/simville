{
  "name": "simville",
  "version": "1.1.0",
  "description": "LLM-driven tribal village life simulation game",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:qa": "vitest run tests/qa",
    "test:regression": "node tests/qa/harness.mjs --regression",
    "test:coverage": "vitest run --coverage",
    "test:suite": "node tests/qa/harness.mjs --suite"
  },
  "author": "Simville Team",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^28.3.3",
    "electron-builder": "^23.3.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.simville.app",
    "productName": "Simville",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simville"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "saves",
        "to": "saves",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
