{
  "output": "sweep-report.json",
  "description": "Parameter sweep: test multiple temperatures and models",
  "replicates": 3,
  "baseConfig": {
    "days": 15,
    "dayLengthMs": 30000,
    "tickIntervalMs": 5000,
    "agentA": {
      "type": "llm",
      "endpoint": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "apiKey": "YOUR_API_KEY",
      "maxTokens": 500
    },
    "agentB": {
      "type": "baseline",
      "name": "heuristic-opponent"
    }
  },
  "sweep": {
    "agentA.temperature": [0.2, 0.4, 0.6, 0.8],
    "agentA.model": ["gpt-4o-mini", "gpt-4o"]
  }
}
